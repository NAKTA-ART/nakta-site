---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WorkCard from '~/components/WorkCard.astro';
import { SITE } from '~/lib/site';
import { getLatestWorks } from '~/lib/works';

// 홈은 카테고리 구분 없이 최신 4개만 보여줍니다.
// [0] = 우측 대형 이미지, [1~3] = 좌측 썸네일(위에서부터)
const works = await getLatestWorks(4);
const hero = works[0];
const thumbs = works.slice(1, 4);
---

<BaseLayout>
  <div class="home">
    {
      thumbs.map((work, i) => (
        <div class="home__cell" style={`grid-column:1;grid-row:${i + 1}`}>
          <WorkCard work={work} aspect={486 / 365} sizes="(max-width: 720px) 100vw, 27vw" />
        </div>
      ))
    }

    <div class="home__copy">
      <h1>
        {SITE.tagline.map((line) => <span class="home__line">{line}</span>)}
      </h1>
    </div>

    {
      hero && (
        <div class="home__cell home__cell--wide">
          <WorkCard work={hero} aspect={1303 / 745} sizes="(max-width: 720px) 100vw, 73vw" priority />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  /*
    시안 좌표: 좌 486px / 우 1303px, 행 높이 365px, 행간 16px, 열간 25px.
    행 높이를 뷰포트에서 역산해 헤더 + 3행 + 푸터가 정확히 한 화면에 맞습니다.
  */
  .home {
    --home-rowgap: clamp(8px, 0.83vw, 16px);
    --home-row: calc(
      (100dvh - var(--header-h) - var(--footer-h) - 2 * var(--home-rowgap)) / 3
    );

    display: grid;
    grid-template-columns: minmax(0, var(--col-left)) minmax(0, var(--col-right));
    grid-template-rows: repeat(3, var(--home-row));
    gap: var(--home-rowgap) var(--gap-col);
    padding-inline: var(--page-pad);
  }

  .home__cell {
    min-height: 0;
  }

  .home__cell--wide {
    grid-column: 2;
    grid-row: 2 / span 2;
  }

  /* 셀이 행 높이에 정확히 맞도록 카드 자체 비율을 무시하고 채웁니다 */
  .home__cell :global(.card) {
    aspect-ratio: auto !important;
    height: 100%;
  }

  .home__copy {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 0;
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--f-display);
    font-weight: 400;
    /* 시안에서 두 번째 줄이 우측 컬럼 폭의 92%를 차지하도록 맞춘 값 */
    font-size: clamp(2rem, 5.9vw, 113px);
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--c-lavender);
    text-align: right;
  }

  /* 시안처럼 두 줄로 고정 — 줄바꿈되면 행 높이가 밀려 첫 화면이 어긋납니다 */
  .home__line {
    display: block;
    white-space: nowrap;
  }

  /* ---- 모바일: 헤드라인 → 대형 → 썸네일 세로 스택 ---- */
  @media (max-width: 720px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: 12px;
      padding-block: 18px 24px;
    }

    .home__copy,
    .home__cell {
      grid-column: 1 !important;
      grid-row: auto !important;
    }

    .home__copy {
      order: -2;
      justify-content: flex-start;
      padding-block: 6px 14px;
    }

    .home__cell--wide {
      order: -1;
    }

    h1 {
      align-items: flex-start;
      text-align: left;
      font-size: clamp(2rem, 11vw, 4rem);
    }

    .home__line {
      white-space: normal;
    }

    .home__cell :global(.card) {
      aspect-ratio: 4 / 3 !important;
      height: auto;
    }

    .home__cell--wide :global(.card) {
      aspect-ratio: 1303 / 745 !important;
    }
  }
</style>
